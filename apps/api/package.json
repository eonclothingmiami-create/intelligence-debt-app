{
  "name": "@fie/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Financial OS API — Hera webhooks → domain events → projections",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fie/erp-integration": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
